# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/reports/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.tsbuildinfo
.eslintcache
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local configuration and secrets
.env*
.dev.vars*
!.env.example
!.env.*.example
!.dev.vars.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Compact compiler output
/contract/src/managed/
